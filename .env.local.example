# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local a Git.

# --- Seguridad (obligatorio en producción) ---
# Cadena larga y aleatoria: openssl rand -base64 32
SESSION_SECRET=
# Contraseña del panel /admin
ADMIN_PASSWORD=
# URL pública del sitio (PayPhone redirige aquí al terminar el pago)
PUBLIC_BASE_URL=https://tu-dominio.com

# --- PayPhone (pagos en línea, Ecuador) ---
# Token y Store ID desde PayPhone Developer (developers.payphone.app)
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
# Sólo si PayPhone cambia las rutas:
# PAYPHONE_API_BASE=https://pay.payphonetodoesposible.com
# PAYPHONE_PREPARE_PATH=/api/button/Prepare
# PAYPHONE_CONFIRM_PATH=/api/button/V2/Confirm

# --- Verificación del celular por WhatsApp (Meta Cloud API) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Plantilla de autenticación aprobada en Meta (con un parámetro: el código)
WHATSAPP_OTP_TEMPLATE=codigo_verificacion
WHATSAPP_OTP_LANG=es

# --- Comprobante por correo (Resend) ---
RESEND_API_KEY=
MAIL_FROM="Fuoco <pedidos@tu-dominio.com>"
